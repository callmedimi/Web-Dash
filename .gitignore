# ==============================================================================
# Web-Dash Git Ignore Policy
# Enterprise-hardened rules for Python, Flask, Node/React, IDEs, and Secrets
# ==============================================================================

# --- Python Cache & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environments ---
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# --- Testing, Coverage & Linters ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# --- Security, State & Secrets (F-08 / Step 1.1) ---
data/
users.json
.secret_key
*.env
*.env.*
!config.example.env
*.pem
*.key
*.cert
*.crt
zabbix_config.ini
zabbix_router_db.json
alarm-clearing.tar

# --- Local / Production Overrides (Never commit) ---
*.local
*.local.*
config.local.ini
vrf_map.local.json
arp_mac.local.csv
production*.ini
production*.json

# --- Databases & Dynamic State ---
*.db
*.sqlite
*.sqlite3
instance/
uploads/
exports/
scratch/
arp_mac.csv

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Frontend & Node (Phase 6 / Phase 7) ---
node_modules/
frontend/node_modules/
# Note: frontend/dist/ is intentionally tracked for air-gapped production mounts
!frontend/dist/
!frontend/dist/**
.eslintcache
.vite/
.turbo/

# --- IDEs, Editors & OS Files ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db

# --- AI Assistants & Local Metadata ---
.gemini/
.claude/
.continue/
.kilo/
.kilocode/
.cursor/

# --- Scratch & Ad-hoc Local Scripts ---
renew_lic_V3.py
ui-design-system/