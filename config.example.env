# VRF and BGP Routing Check Infrastructure (Step 1.7)
VRF_ROUTER_NAME=IRRHAC
VRF_ROUTER_IP=10.0.101.23
VRF_RR_IP=10.0.7.10

# Site ARP & MAC Collector target prefixes
TARGET_NE_PREFIXES=IL,BR,BA,BC

# Zabbix configuration
ZABBIX_URL=https://zabbix.example.com/api_jsonrpc.php
ZABBIX_TOKEN=b8a512349f2c
# Alternatively:
# ZABBIX_USER=admin
# ZABBIX_PASSWORD=secret123
ZABBIX_VERIFY_SSL=true
ZABBIX_TIMEOUT=30
ZABBIX_MAX_RETRIES=3
ZABBIX_RETRY_BASE_DELAY=1.0
ZABBIX_RETRYABLE_STATUSES=429,500,502,503,504
